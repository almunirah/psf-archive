# Supabase public configuration. Use a dedicated PSF Archive project only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Development uses mock storage by default.
STORAGE_DRIVER=mock

# Configure only inside the PSF internal environment when NAS integration is enabled.
# Never place office NAS SMB credentials in Vercel.
NAS_HOST=
NAS_SHARE=
NAS_USERNAME=
NAS_PASSWORD=
NAS_ARCHIVE_PATH=MYFOTO_ARCHIVE
